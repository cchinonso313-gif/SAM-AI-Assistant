# API Configuration
GEMINI_API_KEY=your-gemini-api-key-here
GROQ_API_KEY=your-groq-api-key-here

# System Settings
SAM_NAME=SAM
DEFAULT_MODEL=gemini
FALLBACK_MODEL=groq
DEBUG_MODE=False
LOG_LEVEL=INFO

# Voice Settings
VOICE_ENABLED=True
MIC_INDEX=0
TTS_ENGINE=pyttsx3
VOICE_RATE=150
VOICE_VOLUME=0.9

# Desktop Settings
INDICATOR_ENABLED=True
INDICATOR_SIZE=50
INDICATOR_COLOR=#00FF00

# Security
ENCRYPTION_ENABLED=True
MAX_HISTORY_DAYS=30
AUTO_CLEAR_CACHE=True

# Web Dashboard
DASHBOARD_HOST=127.0.0.1
DASHBOARD_PORT=8000
# Token required to access the dashboard API/WebSocket. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
# If left blank, a random token is generated at runtime and printed to the logs.
DASHBOARD_TOKEN=
