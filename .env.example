# API Configuration
GEMINI_API_KEY=your-gemini-api-key-here
GROQ_API_KEY=your-groq-api-key-here

# System Settings
SAM_NAME=SAM
DEFAULT_MODEL=gemini
FALLBACK_MODEL=groq
DEBUG_MODE=False
LOG_LEVEL=INFO

# Voice Settings
VOICE_ENABLED=True
MIC_INDEX=0
TTS_ENGINE=pyttsx3
VOICE_RATE=150
VOICE_VOLUME=0.9

# Desktop Settings
INDICATOR_ENABLED=True
INDICATOR_SIZE=50
INDICATOR_COLOR=#00FF00

# Security
ENCRYPTION_ENABLED=True
MAX_HISTORY_DAYS=30
AUTO_CLEAR_CACHE=True
